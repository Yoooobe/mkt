API_KEY=gere_com_openssl_rand_hex_16

# Tracking opcional via API pública do site + Sanity.
# Sem estes valores, o dashboard roda normalmente, mas abertura/clique ficam desativados.
TRACKING_BASE_URL=https://plataforma.4unik.com.br/api/email
TRACKING_SECRET=gere_um_segredo_longo
TRACKING_SYNC_KEY=gere_outro_segredo_longo

# Integração somente leitura com Google Analytics, Tag Manager e Google Ads.
# O dashboard nunca cria anúncios ou altera tags; use IDs sem hífens se preferir.
GOOGLE_GA4_ACCOUNT_ID=
GOOGLE_GA4_PROPERTY_ID=
GOOGLE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_GTM_ACCOUNT_ID=
GOOGLE_GTM_CONTAINER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# GA4 Data API para a aba "Site & Ads" (visitas/fontes/funil por utm_campaign).
# Property da 4unik: 327916606. Credencial: service account com Viewer na propriedade
# (a mesma landing-ga4-reader@institucional-480905 do repo landing) OU OAuth gcloud
# já autorizado (fallback automático). Sem isso a aba mostra "GA4 não configurado".
GA4_PROPERTY_ID=327916606
GA4_CREDENTIALS_JSON=
GA4_HOSTNAME_PLATAFORMA=plataforma.4unik.com.br
GA4_HOSTNAME_LOJA=4unik.com.br

# Measurement Protocol — marca campanhas ativadas na linha do tempo do GA4
# (evento email_campaign_activated). api_secret: GA4 Admin → stream → Measurement Protocol.
GA4_MEASUREMENT_ID=G-SMJDYCENBC
GA4_MP_API_SECRET=

# Vertex AI — backend padrão da IA (geração de campanhas, classificação de respostas).
# Provider: vertex (Gemini no projeto GCP abaixo) ou claude (CLI local `claude -p`).
# VERTEX_CREDENTIALS_JSON aceita caminho de um JSON de service account (role
# roles/aiplatform.user) ou o próprio JSON inline (útil em containers/secrets).
FOURUNIK_MAIL_PROVIDER=vertex
VERTEX_PROJECT_ID=mkt-4unik
VERTEX_LOCATION=global
VERTEX_CREDENTIALS_JSON=/caminho/para/vertex-sa.json
VERTEX_MODEL_PRO=gemini-2.5-pro
VERTEX_MODEL_FLASH=gemini-2.5-flash

# Notificação de lead novo do site: email de destino (WhatsApp usa ZAPI_PHONE)
LEADS_NOTIFY_EMAIL=comercial@4unik.com.br
