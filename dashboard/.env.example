API_KEY=gere_com_openssl_rand_hex_16

# Tracking opcional via API pública do site + Sanity.
# Sem estes valores, o dashboard roda normalmente, mas abertura/clique ficam desativados.
TRACKING_BASE_URL=https://leads-ingest-api.vercel.app/api/email
TRACKING_SECRET=gere_um_segredo_longo
TRACKING_SYNC_KEY=gere_outro_segredo_longo

# Integração somente leitura com Google Analytics, Tag Manager e Google Ads.
# O dashboard nunca cria anúncios ou altera tags; use IDs sem hífens se preferir.
GOOGLE_GA4_ACCOUNT_ID=
GOOGLE_GA4_PROPERTY_ID=
GOOGLE_GA4_MEASUREMENT_ID=
GOOGLE_GTM_ACCOUNT_ID=
GOOGLE_GTM_CONTAINER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# GA4 Data API para a aba "Site & Ads". Configure IDs da propriedade Yoobe autorizada.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GA4_HOSTNAME_PLATAFORMA=corporate.yoobe.co
GA4_HOSTNAME_LOJA=catalogo.yoobe.co

# Measurement Protocol — marca campanhas ativadas na linha do tempo do GA4
# (evento email_campaign_activated). api_secret: GA4 Admin → stream → Measurement Protocol.
GA4_MEASUREMENT_ID=
GA4_MP_API_SECRET=

# OAuth Gmail web no painel remoto. Cadastre o callback exato no cliente OAuth.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://gws4unik-dashboard.genau-d0b.workers.dev/oauth/gmail/callback
GMAIL_OAUTH_ENCRYPTION_KEY=

# Vertex AI — backend padrão da IA (geração de campanhas, classificação de respostas).
# Provider: vertex (Gemini no projeto GCP abaixo) ou claude (CLI local `claude -p`).
# VERTEX_CREDENTIALS_JSON aceita caminho de um JSON de service account (role
# roles/aiplatform.user) ou o próprio JSON inline (útil em containers/secrets).
FOURUNIK_MAIL_PROVIDER=vertex
VERTEX_PROJECT_ID=mkt-4unik
VERTEX_LOCATION=global
VERTEX_CREDENTIALS_JSON=/caminho/para/vertex-sa.json
VERTEX_MODEL_PRO=gemini-2.5-pro
VERTEX_MODEL_FLASH=gemini-2.5-flash

# Grok 4.5 — crítico / segundo parecer (portfólio, validador de melhorias, SEO/GEO).
# Vertex: habilite o card xAI/Grok no Model Garden do projeto antes de ligar.
# Transporte: OpenAPI chat/completions (não generateContent do Gemini).
GROK_ENABLED=1
# Preferir xai/grok-4.5 quando habilitado no Model Garden; fallback estável:
VERTEX_GROK_MODEL=xai/grok-4.20-reasoning
VERTEX_GROK_LOCATION=global
# Fallback opcional na API direta da xAI (se Vertex falhar / modelo não habilitado):
# XAI_API_KEY=          # ou GROK_API_KEY= (alias)
# XAI_GROK_MODEL=grok-4.5

# Agent Engine (após `adk deploy` — ver agents/README.md). Vazio = fallback generate_json.
VERTEX_AGENT_LOCATION=us-central1
VERTEX_AGENT_NAME_ANALYZER=
VERTEX_AGENT_LEAD_VALIDATOR=

# Loop de melhorias com agentes (1 = ligado; 0 = kill switch).
IMPROVEMENTS_ENABLED=1

# Firecrawl — evidência pública (orçamento apertado: ~1 crédito/lead).
# Key: mesma do firecrawl-mcp (~/.cursor/mcp.json). Nunca commitar.
FIRECRAWL_API_KEY=
FIRECRAWL_CREDIT_BUDGET=35
FIRECRAWL_MAX_LEADS_PER_JOB=10
LEAD_EVIDENCE_TTL_DAYS=30
LEAD_QUALITY_WORKER_URL=
LEAD_QUALITY_SYNC_KEY=
# Opcional após adk deploy scrape_planner:
# VERTEX_AGENT_SCRAPE_PLANNER=

# Notificação de lead novo do site: email de destino (WhatsApp usa ZAPI_PHONE)
LEADS_NOTIFY_EMAIL=corporate@yoobe.co
# Eventos comerciais do Catálogo (POST /api/integrations/events, HMAC t=,v1=). Vazio = rota desligada (503).
# Mesmo valor de MARKETING_EVENTS_SECRET no Catálogo.
CATALOG_EVENTS_SECRET=
