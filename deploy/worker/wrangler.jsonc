// 4unik.mail — Worker que expõe o dashboard rodando em Cloudflare Containers.
// Deploy: `wrangler deploy` a partir de deploy/worker (ver deploy/README.md).
{
  "name": "gws4unik-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  // Deixar "" no dia a dia. Só "1" no rebootstrap pontual (seed + wipe da réplica).
  "vars": {
    "FORCE_SEED_DB": ""
  },
  "containers": [
    {
      "class_name": "DashboardContainer",
      // Dockerfile fica em deploy/, mas o contexto de build é a raiz do repo
      // (precisa de dashboard/ e proposals/). Caminhos relativos a este arquivo.
      "image": "../Dockerfile",
      "image_build_context": "../..",
      // SQLite = 1 escritor. NUNCA aumente: duas instâncias replicando o mesmo
      // caminho no R2 corrompem a réplica do Litestream.
      "max_instances": 1,
      // basic (¼ vCPU / 1 GiB) engasga com ~60k contacts + Python. standard-1
      // = ½ vCPU / 4 GiB / 8 GB disco — mínimo viável para o CRM remoto.
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DASHBOARD",
        "class_name": "DashboardContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DashboardContainer"]
    }
  ]
}
