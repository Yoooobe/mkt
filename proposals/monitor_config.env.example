# Configuração do monitor de respostas.
CALENDLY_URL=https://calendly.com/4unik/30min?month=2026-07

# Comece sempre em off. Ligue somente depois de validar os rascunhos.
AUTO_REPLY=off
AUTO_REPLY_CLASSES=agendar,interessado,pergunta_simples,recusa_encerrar
CONF_MIN=0.8
MAX_AUTOREPLIES_DIA=10
MAX_AUTOREPLIES_POR_THREAD_DIA=1
